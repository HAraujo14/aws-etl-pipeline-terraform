# Local mode writes under ./data and does not call AWS.
STORAGE_BACKEND=local
LOCAL_DATA_DIR=data
LOG_LEVEL=INFO
FORECAST_DAYS=1
QUALITY_MAX_NULL_RATIO=0.05

# Uncomment to ingest more than the default three cities.
# LOCATIONS_JSON=[{"location_id":"berlin","latitude":52.52,"longitude":13.41}]

# S3 mode is for the Lambda runtime and for an optional moto/local AWS test.
# STORAGE_BACKEND=s3
# S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1
# RAW_PREFIX=raw/weather
# CURATED_PREFIX=curated/weather
# QUALITY_PREFIX=quality/weather
